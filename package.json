    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "papaparse": "5.7.0",
    "preact": "10.29.8",
    "react-i18next": "17.0.15",
    "read-excel-file": "9.3.10",
    "write-excel-file": "4.1.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "2.10.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "pyodide": "0.27.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^5.0.3"
  },
  "homepage": "https://almhdy24.github.io/sigma/",
  "resolutions": {
