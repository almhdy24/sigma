  "private": true,
  "author": "Elmahdi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/almhdy24/sigma"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "engine:manifest": "node scripts/gen-engine-manifest.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "bidi-js": "1.1.0",
